                        "enabled": {
                            "type": "boolean"
                        },
                        "name": {
                            "type": "string"
                        },
                        "podSecurityContext": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "runAsNonRoot": {
                                    "type": "boolean"
                                },
                                "seccompProfile": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "type": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        },
                        "serviceType": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "global": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "imagePullSecrets": {
