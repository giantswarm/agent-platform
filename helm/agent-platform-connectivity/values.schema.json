                            "additionalProperties": false
                        },
                        "enabled": {
                            "type": "boolean"
                        },
                        "labels": {
                            "type": "object",
                            "additionalProperties": false
                        },
                        "timeout": {
                            "type": "string"
                        }
                    }
                },
                "hostnames": {
                    "type": "array"
                },
                "httpRoute": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "annotations": {
                            "type": "object",
                            "additionalProperties": false
                        },
                        "labels": {
                            "type": "object",
                            "additionalProperties": false
                        },
                        "mcp": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "annotations": {
                                    "type": "object",
                                    "additionalProperties": false
                                },
                                "labels": {
                                    "type": "object",
                                    "additionalProperties": false
                                }
                            }
                        },
                        "muster": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "annotations": {
                                    "type": "object",
                                    "additionalProperties": false
                                },
                                "labels": {
                                    "type": "object",
                                    "additionalProperties": false
                                }
                            }
                        }
                    }
                },
                "mode": {
                    "type": "string"
                },
                "parentRefs": {
                    "type": "array"
                }
            }
        },
        "kagent": {
            "type": "object",
            "additionalProperties": true
        },
        "klausGateway": {
            "type": "object",
            "additionalProperties": true
        },
        "mcps": {
            "type": "object",
            "additionalProperties": true
        },
        "muster": {
            "type": "object",
            "additionalProperties": true
        },
        "networkPolicy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "additionalEgressCIDRs": {
                    "type": "array"
                },
                "additionalEgressFQDNs": {
                    "type": "array"
                },
                "enabled": {
                    "type": "boolean"
                },
                "flavor": {
                    "type": "string"
                },
                "kubernetes": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "apiServerCIDR": {
                            "type": "string"
                        },
                        "worldExcludedCIDRs": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "musterInClusterMcpPorts": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                }
            }
        },
        "postgres": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "applicationDatabase": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "name": {
                            "type": "string"
                        },
                        "owner": {
                            "type": "string"
                        },
                        "schema": {
                            "type": "string"
                        }
                    }
                },
                "clusterName": {
                    "type": "string"
                },
                "enabled": {
                    "type": "boolean"
                },
                "image": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "name": {
                            "type": "string"
                        }
                    }
                },
                "instances": {
                    "type": "integer"
                },
                "namespace": {
                    "type": "string"
                },
                "sessionsDatabase": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "name": {
                            "type": "string"
                        },
                        "owner": {
                            "type": "string"
                        }
                    }
                },
                "storage": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "size": {
                            "type": "string"
                        },
                        "storageClass": {
                            "type": "string"
                        }
                    }
                },
                "vector": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "extensionImage": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "reference": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "valkey": {
            "type": "object",
            "additionalProperties": true
        }
    }
}
