{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "agent-platform-mcps": {
            "type": "object",
            "additionalProperties": true
        },
        "agentSandbox": {
            "type": "object",
            "additionalProperties": true
        },
        "agentgateway": {
            "type": "object",
            "additionalProperties": true
        },
        "agentic-platform-mcps": {
            "type": "object",
            "description": "Deprecated former name of the `agent-platform-mcps` block. Overrides set under this key are merged OVER `agent-platform-mcps` (legacyValuesFrom / the connectivity _helpers.tpl merge) so consumers still setting the old key keep working. Free-form on purpose: the schema must keep accepting those overrides until the key is retired.",
            "additionalProperties": true
        },
        "dicebear": {
            "type": "object",
            "additionalProperties": true
        },
        "extraObjects": {
            "type": "array"
        },
        "gateway": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "gatewayClassName": {
                    "type": "string"
                },
                "jwksEgress": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "namespace": {
                            "type": "string"
                        },
                        "podSelector": {
                            "type": "object",
                            "additionalProperties": false
                        },
                        "port": {
                            "type": "integer"
                        }
                    }
                },
                "listeners": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "allowedRoutes": {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                    "namespaces": {
                                        "type": "object",
                                        "additionalProperties": false,
                                        "properties": {
                                            "from": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                }
                            },
                            "name": {
                                "type": "string"
                            },
                            "port": {
                                "type": "integer"
                            },
                            "protocol": {
                                "type": "string"
                            }
                        }
                    }
                },
                "name": {
                    "type": "string"
                },
                "parameters": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "containerSecurityContext": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "allowPrivilegeEscalation": {
                                    "type": "boolean"
                                },
                                "capabilities": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "drop": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                },
                                "readOnlyRootFilesystem": {
                                    "type": "boolean"
                                },
                                "runAsNonRoot": {
                                    "type": "boolean"
                                },
                                "seccompProfile": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "type": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        },
                        "dataPlaneEnv": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "value": {
                                        "type": "string"
                                    }
                                }
                            }
                        },
                        "dataPlaneResources": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "limits": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "ephemeral-storage": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "requests": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "ephemeral-storage": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        },
                        "dataPlaneVolumeMounts": {
                            "type": "array"
                        },
                        "dataPlaneVolumes": {
                            "type": "array"
